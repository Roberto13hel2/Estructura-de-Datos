def bolivianos_a_soles():
    try:
        bolivianos = float(entry_monto.get())
        compra_usdt_bs = float(entry_compra_usdt_bs.get())
        venta_usdt_soles = float(entry_venta_usdt_soles.get())
        comision = float(entry_comision.get())

        if bolivianos <= 0 or compra_usdt_bs <= 0 or venta_usdt_soles <= 0:
            messagebox.showwarning("Advertencia", "El monto y los precios deben ser mayores a 0.")
            return

        if comision < 0:
            messagebox.showwarning("Advertencia", "La comisión no puede ser negativa.")
            return

        usdt = bolivianos / compra_usdt_bs
        soles_base = usdt * venta_usdt_soles

        monto_comision = soles_base * (comision / 100)
        soles_con_comision = soles_base + monto_comision

        resultado.set(
            f"Conversión de Bs a Soles:\n\n"
            f"🇧🇴 Monto ingresado: Bs {bolivianos:.2f}\n"
            f"💵 Equivalente: {usdt:.4f} USDT\n"
            f"🇵🇪 Soles base: S/ {soles_base:.2f}\n\n"
            f"💼 Comisión {comision:.2f}%: S/ {monto_comision:.2f}\n"
            f"✅ Total a cobrar: S/ {soles_con_comision:.2f}"
        )

    except ValueError:
        messagebox.showerror("Error", "Ingrese solo números válidos.")


