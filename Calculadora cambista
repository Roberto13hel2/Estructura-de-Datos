# ---------------- DISEÑO PERSONALIZADO ----------------

def crear_rectangulo_redondeado(canvas, x1, y1, x2, y2, radio=25, color="#FFFFFF"):
    puntos = [
        x1 + radio, y1,
        x2 - radio, y1,
        x2, y1,
        x2, y1 + radio,
        x2, y2 - radio,
        x2, y2,
        x2 - radio, y2,
        x1 + radio, y2,
        x1, y2,
        x1, y2 - radio,
        x1, y1 + radio,
        x1, y1
    ]

    return canvas.create_polygon(
        puntos,
        smooth=True,
        fill=color,
        outline=color
    )


class TarjetaRedondeada(tk.Canvas):
    def __init__(self, parent, color="#FFFFFF", radio=30, **kwargs):
        super().__init__(
            parent,
            bg=parent["bg"],
            highlightthickness=0,
            **kwargs
        )
        self.color = color
        self.radio = radio
        self.bind("<Configure>", self.dibujar)

    def dibujar(self, event=None):
        self.delete("all")
        crear_rectangulo_redondeado(
            self,
            5,
            5,
            self.winfo_width() - 5,
            self.winfo_height() - 5,
            self.radio,
            self.color
        )


class BotonRedondeado(tk.Canvas):
    def __init__(
        self,
        parent,
        texto,
        color,
        color_hover,
        color_texto,
        comando,
        radio=30,
        altura=52,
        **kwargs
    ):
        super().__init__(
            parent,
            height=altura,
            bg=parent["bg"],
            highlightthickness=0,
            cursor="hand2",
            **kwargs
        )

        self.texto = texto
        self.color = color
        self.color_hover = color_hover
        self.color_texto = color_texto
        self.comando = comando
        self.radio = radio

        self.bind("<Configure>", self.dibujar)
        self.bind("<Button-1>", lambda e: self.comando())
        self.bind("<Enter>", self.hover)
        self.bind("<Leave>", self.normal)

    def dibujar(self, event=None, color_actual=None):
        self.delete("all")

        if color_actual is None:
            color_actual = self.color

        ancho = self.winfo_width()
        alto = self.winfo_height()

        crear_rectangulo_redondeado(
            self,
            3,
            3,
            ancho - 3,
            alto - 3,
            self.radio,
            color_actual
        )

        self.create_text(
            ancho / 2,
            alto / 2,
            text=self.texto,
            fill=self.color_texto,
            font=("Arial", 12, "bold")
        )

    def hover(self, event=None):
        self.dibujar(color_actual=self.color_hover)

    def normal(self, event=None):
        self.dibujar(color_actual=self.color)


def crear_entry(parent):
    contenedor = tk.Frame(parent, bg="#FFFFFF")
    contenedor.pack(fill="x", pady=(6, 14))

    fondo_entry = TarjetaRedondeada(
        contenedor,
        color="#F3F4F6",
        radio=22,
        height=48
    )
    fondo_entry.pack(fill="x")

    entrada = tk.Entry(
        fondo_entry,
        font=("Arial", 14),
        justify="center",
        bg="#F3F4F6",
        fg="#111111",
        relief="flat",
        bd=0,
        insertbackground="#111111"
    )

    entrada.place(
        relx=0.5,
        rely=0.5,
        relwidth=0.90,
        relheight=0.62,
        anchor="center"
    )

    return entrada


